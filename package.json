{
  "name": "LQ-23_WebdriverIO-framework",
  "type": "module",
  "devDependencies": {
    "@wdio/allure-reporter": "^9.12.6",
    "@wdio/cli": "^9.12.7",
    "@wdio/devtools-service": "^8.42.0",
    "@wdio/local-runner": "^9.12.5",
    "@wdio/mocha-framework": "^9.12.5",
    "@wdio/spec-reporter": "^9.12.3",
    "cross-env": "^7.0.3",
    "webdriverio": "^9.12.7"
  },
  "scripts": {
    "test:shop": "npx wdio run ./wdio.chrome.conf.ts --spec actionsShopPage.ts",
    "test:home": "npx wdio run ./wdio.chrome.conf.ts --spec actionsHomePage.ts",
    "test:contact": "npx wdio run ./wdio.chrome.conf.ts --spec actionsContactUsPage.ts",
    "test:pricing": "npx wdio run ./wdio.chrome.conf.ts --spec actionsPricingPage.ts",
    "test:solutions": "npx wdio run ./wdio.chrome.conf.ts --spec actionsSolutionsPage.ts",
    "test:chrome": "npx wdio run ./wdio.chrome.conf.ts",
    "test:safari": "npx wdio run ./wdio.safari.conf.ts",
    "test:firefox": "npx wdio run ./wdio.firefox.conf.ts",
    "test:all": "npx wdio run ./wdio.chrome.conf.ts",
    "test:test": "cross-env NODE_ENV=test wdio wdio.chrome.conf.ts",
    "test:prod": "cross-env NODE_ENV=prod wdio wdio.chrome.conf.ts",
    "genReport": "npx allure-commandline generate allure-results --clean -o allure-report",
    "openReport": "npx allure open allure-report"
  },
  "dependencies": {
    "@faker-js/faker": "^9.7.0"
  }
}
